{
  "name": "firstseen-job-discovery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Direct-to-employer job discovery and recommendation for one candidate.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "worker:dev": "./node_modules/inngest-cli/bin/inngest dev --no-discovery -u http://127.0.0.1:3000/api/inngest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx --yes supabase@latest migration up --local",
    "db:seed": "tsx scripts/seed.ts",
    "db:fixture": "NODE_OPTIONS=--conditions=react-server tsx scripts/seed-browser-fixture.ts",
    "db:owner": "tsx scripts/create-local-owner.ts",
    "env:local": "tsx scripts/configure-local-env.ts",
    "smoke:openai": "tsx scripts/smoke-openai.ts",
    "smoke:connectors": "tsx scripts/smoke-connectors.ts",
    "smoke:slack": "tsx scripts/smoke-slack.ts",
    "smoke:discovery": "tsx scripts/smoke-discovery.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@sentry/nextjs": "^10.32.1",
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.111.0",
    "cheerio": "^1.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "inngest": "^4.14.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "openai": "^7.3.0",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.12",
    "inngest-cli": "1.40.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.0.0 <25"
  },
  "packageManager": "pnpm@11.9.0"
}
